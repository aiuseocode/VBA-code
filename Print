' 1シート分の印刷設定（白黒、向きはシートの設定のまま）
'  ・手動の改ページがあるシート：改ページごとのブロックが1枚に収まる倍率にする
'  ・手動の改ページがないシート：横幅を1ページに収める
Private Sub PrSetup(ws As Worksheet)
    Dim z As Long
    On Error Resume Next
    z = PrZoomForBreaks(ws)   ' 0 なら手動の改ページなし

    Application.PrintCommunication = False   ' 設定中はプリンターと通信しない（高速化）
    With ws.PageSetup
        If z > 0 Then
            .Zoom = z                  ' 計算した倍率
        Else
            .Zoom = False
            .FitToPagesWide = 1        ' 横幅を1ページに収める
            .FitToPagesTall = False    ' 縦は自動
        End If
        .BlackAndWhite = True          ' 白黒印刷（背景色は印刷されない）
    End With
    Application.PrintCommunication = True    ' ここで設定がまとめて反映される
End Sub

' 改ページごとのブロックが用紙1枚に収まる倍率(%)を返す（手動の改ページがなければ0）
Private Function PrZoomForBreaks(ws As Worksheet) As Long
    Dim area As Range
    Dim r As Long, c As Long, r1 As Long, r2 As Long, c1 As Long, c2 As Long, s As Long
    Dim hasBreak As Boolean
    Dim h As Double, w As Double, maxH As Double, maxW As Double
    Dim titleH As Double, titleW As Double
    Dim pw As Double, ph As Double, tmp As Double, z As Double

    On Error GoTo NG
    Set area = PrArea(ws)
    If area Is Nothing Then Exit Function
    r1 = area.Row: r2 = r1 + area.Rows.Count - 1
    c1 = area.Column: c2 = c1 + area.Columns.Count - 1

    ' 縦方向：手動改ページで区切った各ブロックの高さの最大
    s = r1
    For r = r1 + 1 To r2 + 1
        If r > r2 Then
            h = ws.Range(ws.Rows(s), ws.Rows(r2)).Height
            If h > maxH Then maxH = h
        ElseIf ws.Rows(r).PageBreak = xlPageBreakManual Then
            hasBreak = True
            h = ws.Range(ws.Rows(s), ws.Rows(r - 1)).Height
            If h > maxH Then maxH = h
            s = r
        End If
    Next r
    If Not hasBreak Then Exit Function

    ' 横方向：手動改ページで区切った各ブロックの幅の最大
    s = c1
    For c = c1 + 1 To c2 + 1
        If c > c2 Then
            w = ws.Range(ws.Columns(s), ws.Columns(c2)).Width
            If w > maxW Then maxW = w
        ElseIf ws.Columns(c).PageBreak = xlPageBreakManual Then
            w = ws.Range(ws.Columns(s), ws.Columns(c - 1)).Width
            If w > maxW Then maxW = w
            s = c
        End If
    Next c

    ' 印刷タイトル（毎ページ繰り返す行・列）の分も足す
    On Error Resume Next
    If ws.PageSetup.PrintTitleRows <> "" Then titleH = ws.Range(ws.PageSetup.PrintTitleRows).Height
    If ws.PageSetup.PrintTitleColumns <> "" Then titleW = ws.Range(ws.PageSetup.PrintTitleColumns).Width
    On Error GoTo NG
    maxH = maxH + titleH
    maxW = maxW + titleW
    If maxH <= 0 Or maxW <= 0 Then Exit Function

    ' 用紙の印刷できる範囲（余白を引いたサイズ）
    PrPaperSize ws.PageSetup.PaperSize, pw, ph
    If ws.PageSetup.Orientation = xlLandscape Then
        tmp = pw: pw = ph: ph = tmp
    End If
    pw = pw - ws.PageSetup.LeftMargin - ws.PageSetup.RightMargin
    ph = ph - ws.PageSetup.TopMargin - ws.PageSetup.BottomMargin

    ' 縦・横どちらも収まる倍率（少し余裕を持たせる）
    z = pw / maxW
    If ph / maxH < z Then z = ph / maxH
    z = z * 100 * 0.97
    If z > 100 Then z = 100   ' 拡大はしない
    If z < 10 Then z = 10     ' Excelの下限
    PrZoomForBreaks = Int(z)
NG:
End Function

' 印刷範囲（設定があればそれ、なければ使っている範囲）
Private Function PrArea(ws As Worksheet) As Range
    On Error Resume Next
    If ws.PageSetup.PrintArea <> "" Then
        Set PrArea = ws.Range(ws.PageSetup.PrintArea)
        If Not PrArea Is Nothing Then
            If PrArea.Areas.Count > 1 Then Set PrArea = PrArea.Areas(1)
        End If
    Else
        Set PrArea = ws.UsedRange
    End If
End Function

' 用紙サイズ（縦置き）の幅・高さをポイントで返す
Private Sub PrPaperSize(ByVal paper As Long, ByRef w As Double, ByRef h As Double)
    Dim wmm As Double, hmm As Double
    Select Case paper
        Case 8:  wmm = 297:   hmm = 420     ' A3
        Case 11: wmm = 148:   hmm = 210     ' A5
        Case 12: wmm = 257:   hmm = 364     ' B4
        Case 13: wmm = 182:   hmm = 257     ' B5
        Case 1:  wmm = 215.9: hmm = 279.4   ' レター
        Case 5:  wmm = 215.9: hmm = 355.6   ' リーガル
        Case Else: wmm = 210: hmm = 297     ' A4（その他もA4とみなす）
    End Select
    w = Application.CentimetersToPoints(wmm / 10)
    h = Application.CentimetersToPoints(hmm / 10)
End Sub
