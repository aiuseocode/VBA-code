' フォルダ内の差分ファイルをまとめて完成品として保存する（色はそのまま）
'  1. 「差分一覧」シートを削除
'  2. 各シートをA1選択・左上表示にそろえる
'  3. ファイル名から「_差分」以降を消し、「完成品」フォルダに .xlsx で保存
'  ※差分ファイル自体は変更しません。同名の完成品は上書きします
Public Sub フォルダ内の差分ファイルを完成品として保存()
    Dim folder As String, outDir As String, f As String, p As Long
    Dim files As New Collection, v As Variant
    Dim wb As Workbook
    Dim okCount As Long, ngList As String

    With Application.FileDialog(msoFileDialogFolderPicker)
        .Title = "差分ファイルが入っているフォルダを選択"
        If .Show <> -1 Then Exit Sub
        folder = .SelectedItems(1)
    End With
    If Right$(folder, 1) <> "\" Then folder = folder & "\"

    ' 対象ファイルを先に集める（一時ファイル ~$ は除外）
    f = Dir(folder & "*_差分*.xls*")
    Do While f <> ""
        If Left$(f, 2) <> "~$" Then files.Add f
        f = Dir()
    Loop
    If files.Count = 0 Then
        MsgBox "「_差分」が付いたファイルが見つかりませんでした。", vbExclamation
        Exit Sub
    End If
    If MsgBox(files.Count & " 件のファイルを完成品として保存します。" & vbCrLf & _
              "（同じ名前の完成品があれば上書きします）", vbOKCancel + vbQuestion) <> vbOK Then Exit Sub

    outDir = folder & "完成品"
    If Len(Dir(outDir, vbDirectory)) = 0 Then MkDir outDir

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Application.EnableEvents = False   ' 埋め込んだ色付けマクロを動かさない

    For Each v In files
        Application.StatusBar = "処理中: " & v
        Set wb = Nothing
        On Error Resume Next
        Set wb = Workbooks.Open(Filename:=folder & v, UpdateLinks:=0, ReadOnly:=True)
        On Error GoTo 0

        If wb Is Nothing Then
            ngList = ngList & vbCrLf & v & "（開けませんでした）"
        Else
            p = InStrRev(v, "_差分")
            If BatchFinishBook(wb, outDir & "\" & Left$(v, p - 1) & ".xlsx") Then
                okCount = okCount + 1
            Else
                ngList = ngList & vbCrLf & v & "（処理できませんでした）"
            End If
            wb.Close SaveChanges:=False
        End If
    Next v

    Application.StatusBar = False
    Application.EnableEvents = True
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    If ngList = "" Then
        MsgBox "完了しました。" & vbCrLf & okCount & " 件を保存しました。" & vbCrLf & vbCrLf & _
               "保存先:" & vbCrLf & outDir, vbInformation
    Else
        MsgBox "完了しました（一部失敗）。" & vbCrLf & okCount & " 件を保存しました。" & vbCrLf & _
               vbCrLf & "失敗:" & ngList & vbCrLf & vbCrLf & "保存先:" & vbCrLf & outDir, vbExclamation
    End If
End Sub

' 1ファイル分の処理（成功したら True）
Private Function BatchFinishBook(wb As Workbook, ByVal outPath As String) As Boolean
    Dim i As Long
    On Error GoTo NG

    ' 1. 差分一覧シート（差分一覧2 なども）を削除
    For i = wb.Worksheets.Count To 1 Step -1
        If Left$(wb.Worksheets(i).Name, Len("差分一覧")) = "差分一覧" Then
            If wb.Sheets.Count > 1 Then wb.Worksheets(i).Delete
        End If
    Next i

    ' 2. 各シートをA1選択・左上表示にそろえる
    BatchResetView wb

    ' 3. 完成品フォルダに .xlsx で保存
    wb.SaveAs Filename:=outPath, FileFormat:=51   ' 51 = .xlsx
    BatchFinishBook = True
NG:
End Function

' 表示されている全シートをA1選択・左上表示にし、最初のシートを表示する
Private Sub BatchResetView(wb As Workbook)
    Dim ws As Worksheet, firstWs As Worksheet
    On Error Resume Next
    wb.Activate
    For Each ws In wb.Worksheets
        If ws.Visible = xlSheetVisible Then
            If firstWs Is Nothing Then Set firstWs = ws
            ws.Activate
            ws.Range("A1").Select
            ActiveWindow.ScrollRow = 1
            ActiveWindow.ScrollColumn = 1
        End If
    Next ws
    If Not firstWs Is Nothing Then firstWs.Activate
End Sub
